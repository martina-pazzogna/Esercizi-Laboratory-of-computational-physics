   "source": [
    "3. #Write a decorator hello that makes every wrapped function print “Hello!”, i.e. something like:\n",
    "\n",
    "@hello\n",
    "def square(x):\n",
    "    return x*x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 17,
   "id": "07f5e2df-03a1-4290-83af-1a143a480ba7",
   "metadata": {},
   "outputs": [],
   "source": [
    "def hello(func):\n",
    "    def wrapper(x):\n",
    "        print(\"Hello!\")\n",
    "        res = func(x)\n",
    "        print(\"Goodbye!\")\n",
    "        return res\n",
    "\n",
    "    return wrapper"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 18,
   "id": "bbe3fc95-461b-47ca-b9f3-775b73d1ae48",
   "metadata": {},
   "outputs": [],
   "source": [
    "@hello\n",
    "def cube(x):\n",
    "    return x*x*x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 19,
   "id": "8c564b66-753f-4a70-a899-e6dd906d8dc8",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Hello!\n",
      "Goodbye!\n",
      "27\n"
     ]
    }
   ],
   "source": [
    "x = cube(3)\n",
    "print(x)"
   ]
  },
