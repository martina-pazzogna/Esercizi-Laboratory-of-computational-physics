   "source": [
    "7.\\ Cubes\n",
    "\n",
    "Create a list of the cubes of x for x in *[0, 10]* using:\n",
    "\n",
    "a) a for loop\n",
    "\n",
    "b) a list comprehension"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "id": "6229e3e4-1d4d-4050-9489-8f6a88649ab2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 8, 27, 64, 125, 216, 343, 512, 729, 1000]\n"
     ]
    }
   ],
   "source": [
    "#list of cubes using a for loop\n",
    "cubes1 = []\n",
    "for x in range(1,11):\n",
    "    cubes1.append(x**3)\n",
    "\n",
    "print(cubes1)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 9,
   "id": "29d03ce1-e72b-4707-854f-7e9d47d606c9",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "[1, 8, 27, 64, 125, 216, 343, 512, 729, 1000]\n"
     ]
    }
   ],
   "source": [
    "cubes2 = [x**3 for x in range(1,11)]\n",
    "print(cubes2)"
   ]
  },
